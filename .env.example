# Identity and presentation
SITE_NAME=Solar Field A
SITE_CODE=site-01
HMI_TITLE=Solar Park Operations
TIMEZONE=Europe/Berlin
# Attacker-facing UI locale: `ll` or `ll-RR`, e.g. `en`, `uk`, `en-US`
ATTACKER_UI_LOCALE=en
# Fallback must reference a bundled locale pack
ATTACKER_UI_FALLBACK_LOCALE=en

# Plant model
CAPACITY_MW=6.5
ALARM_THRESHOLD_LOW_OUTPUT_PCT=35
# Possible values: disabled, deterministic, open_meteo_forecast, open_meteo_satellite
# Open-Meteo providers require coordinates below; coordinates are not shown in the honeypot UI.
WEATHER_PROVIDER=disabled
WEATHER_LATITUDE="" # e.g. 53.5511
WEATHER_LONGITUDE="" # e.g. 9.9937
WEATHER_ELEVATION_M="" # e.g. 15

# Protocols and services
OPS_ENABLED=1
OPS_BASIC_AUTH_ENABLED=0
OPS_BASIC_AUTH_USERNAME=""
OPS_BASIC_AUTH_PASSWORD=""
# Docker Compose image source. Keep the default for Docker Hub pulls; override
# this to a local tag when testing unpublished images.
HONEYPOT_IMAGE=stoertebeker2k/scada-honeypot:latest
# Official bounded Layer-4 gateway for the public Modbus port.
MODBUS_GATEWAY_IMAGE=haproxy:3.2.21-alpine
# Docker Compose uses fixed internal ports:
# HMI 8080, Modbus 1502, Ops 9090.
# Only the host-published ports below should be changed for deployment.
HMI_PUBLISHED_PORT=8080
MODBUS_PUBLISHED_PORT=1502
# Ops is always published on host-loopback only by compose.yaml.
OPS_PUBLISHED_PORT=9090
# DB-IP Lite GeoIP maintenance is disabled by default. When enabled, pin the
# YYYY-MM release and independently verified SHA-256 values for both archives.
# The updater runs unprivileged and preserves an existing valid database on failure.
GEOIP_DBIP_AUTO_UPDATE=0
GEOIP_DBIP_RELEASE="" # required YYYY-MM pin when enabled, e.g. 2026-04
GEOIP_DBIP_COUNTRY_SHA256="" # required 64-character SHA-256 when enabled
GEOIP_DBIP_ASN_SHA256="" # required 64-character SHA-256 when enabled
GEOIP_DBIP_TIMEOUT_SECONDS=60
GEOIP_DBIP_MAX_COMPRESSED_BYTES=33554432 # 32 MiB per archive
GEOIP_DBIP_MAX_DECOMPRESSED_BYTES=134217728 # 128 MiB per MMDB
GEOIP_DBIP_MAX_EXPANSION_RATIO=64
GEOIP_DBIP_TOTAL_DEADLINE_SECONDS=120 # whole updater run
GEOIP_DBIP_MAX_DIRECTORY_BYTES=268435456 # 256 MiB application-level volume budget
# V1 default: enabled; disable consciously for stricter deployments
ENABLE_SERVICE_LOGIN=1
# Set to 1 only when browsers reach the HMI through HTTPS, e.g. via Caddy.
HMI_COOKIE_SECURE=0
SERVICE_COOKIE_SECURE=0
# Bound server-side lure sessions and successful-login churn.
SERVICE_SESSION_MAX_ACTIVE=128
SERVICE_SESSION_MAX_ACTIVE_PER_USER=8
SERVICE_SESSION_MAX_ADMISSIONS_PER_USER=8
SERVICE_SESSION_ADMISSION_WINDOW_SECONDS=60
# Accept X-Forwarded-For only from explicit reverse-proxy CIDRs.
FORWARDED_HEADER_ENABLED=0
TRUSTED_PROXY_CIDRS="" # e.g. 10.14.0.53/32,127.0.0.1/32

# Event and storage
EVENT_STORE_PATH=./tmp/honeypot-events.db
# Persistent evidence is attacker-driven: keep hard row, age, byte, and free-space bounds enabled.
EVIDENCE_MAX_AGE_DAYS=30
EVIDENCE_MAX_EVENT_ROWS=250000
EVIDENCE_MAX_EVENT_ROWS_PER_SOURCE=25000
EVIDENCE_MAX_ALERT_ROWS=50000
EVIDENCE_MAX_OUTBOX_ROWS=50000
EVIDENCE_MAX_CAMPAIGN_ROWS=10000
EVIDENCE_MAX_CAMPAIGN_ROWS_PER_SOURCE=1000
EVIDENCE_MAX_CREDENTIAL_ROWS=200000
EVIDENCE_MAX_UNIQUE_USERNAMES=100000
EVIDENCE_MAX_UNIQUE_USERNAMES_PER_SOURCE=1000
EVIDENCE_MAX_DATABASE_BYTES=536870912
EVIDENCE_RESERVED_HEALTH_BYTES=16777216
EVIDENCE_MIN_FREE_BYTES=268435456
EVIDENCE_SWEEP_INTERVAL_WRITES=100
JSONL_ARCHIVE_ENABLED=1
JSONL_ARCHIVE_PATH=./logs/events.jsonl
JSONL_ARCHIVE_MAX_FILE_BYTES=67108864
JSONL_ARCHIVE_MAX_TOTAL_BYTES=536870912
JSONL_ARCHIVE_MAX_AGE_DAYS=30
RUNTIME_STATUS_ENABLED=0
RUNTIME_STATUS_PATH=./logs/runtime-status.json
RUNTIME_STATUS_INTERVAL_SECONDS=5
ALERT_MIN_SEVERITY=medium
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_BACKOFF_SECONDS=30
FINDINGS_LOG_PATH=./logs/findings.md

# Exporters
WEBHOOK_EXPORTER_ENABLED=0
WEBHOOK_EXPORTER_URL="" # e.g. https://collector.example.net/honeypot-ingest
SMTP_EXPORTER_ENABLED=0
SMTP_HOST="" # e.g. mail.example.net
SMTP_PORT=465 # implicit TLS with verified server certificate is mandatory
SMTP_FROM="" # e.g. honeypot@example.net
SMTP_TO="" # e.g. alerts@example.net
TELEGRAM_EXPORTER_ENABLED=0
TELEGRAM_BOT_TOKEN="" # e.g. 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID="" # e.g. -1001234567890
# Explicit hostname/port approvals. Webhooks are HTTPS-only; SMTP is TLS-only.
APPROVED_EGRESS_TARGETS="" # e.g. webhook:collector.example.net:443,smtp:mail.example.net:465
# Independent socket-level firewall: every resolved A/AAAA address must fit one
# narrow public CIDR here. Private/special networks stay blocked even if listed.
APPROVED_EGRESS_CIDRS="" # replace documentation ranges with real collector CIDRs
# Public or private OT ranges that must remain unreachable even if accidentally approved.
PROHIBITED_OT_CIDRS=""
# Named export recipients for exposed-research, e.g. `webhook:observer-collector-live`
APPROVED_EGRESS_RECIPIENTS="" # e.g. webhook:observer-collector-live

# Runtime and logging
LOG_LEVEL=info
TREND_WINDOW_MINUTES=180

# Reserved / V1 reference values
# The following settings are loaded or reserved by the runtime, but they do not
# change the current Docker production behavior. Keep them commented unless you
# are working on the corresponding feature path.
#
# OPERATOR_NAME=Regional Energy Services
# INVERTER_BLOCK_COUNT=3
# ENABLE_TRACKER=0
# DEFAULT_POWER_LIMIT_PCT=100
# Prefer Ops /settings for Modbus response timing; these remain boot fallback
# values for deployments that have not saved Ops settings yet.
# MODBUS_RESPONSE_DELAY_MIN_MS=0
# MODBUS_RESPONSE_DELAY_MAX_MS=0
# Bound public Modbus sockets before a handler thread is created.
# MODBUS_MAX_CONNECTIONS=64
# MODBUS_MAX_CONNECTIONS_PER_SOURCE=8
# Container resource ceilings; keep the hard nofile limit >= the soft limit.
# HONEYPOT_PIDS_LIMIT=256
# HONEYPOT_MEMORY_LIMIT=768m
# HONEYPOT_CPU_LIMIT=2.0
# HONEYPOT_NOFILE_SOFT_LIMIT=1024
# HONEYPOT_NOFILE_HARD_LIMIT=2048
# WEATHER_REFRESH_SECONDS=900
# WEATHER_CACHE_TTL_SECONDS=900
# WEATHER_REQUEST_TIMEOUT_SECONDS=10
# EVENT_STORE_BACKEND=sqlite
# PCAP_CAPTURE_ENABLED=0
# PCAP_CAPTURE_PATH=./pcap/session.pcapng
# ALARM_PAGE_SIZE=25
